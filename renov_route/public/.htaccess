DirectoryIndex index.html

RewriteEngine On

# Canonicalisation en UN saut : schema, hote et slash final d'un coup.
# Place avant les regles HTTPS et www a dessein — sinon une requete
# http://www.host/chemin enchainerait trois redirections.
# mod_dir ajoute sinon le slash lui-meme avec le port physique dans l'URL
# (https://renov-route.com:443/...), ce qui cree une chaine de redirection a
# deux sauts vers un hote non canonique.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !^/(assets|_next)/
RewriteRule ^(.*)$ https://renov-route.com/$1/ [R=301,L]

# Force HTTPS redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://renov-route.com%{REQUEST_URI} [L,R=301]

# Redirect www to non-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://renov-route.com/$1 [R=301,L]

# Redirections 301 des anciennes URLs vers les nouvelles
# Redirections spécifiques des anciennes URLs du site
RewriteRule ^marquage-routier-lyon-69/?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]
RewriteRule ^contact/?$ https://renov-route.com/qui-sommes-nous/ [R=301,L]
RewriteRule ^blank-1/?$ https://renov-route.com/competences/resine-sol-marquage-interieur/ [R=301,L]
RewriteRule ^blank/?$ https://renov-route.com/competences/resine-sol-marquage-interieur/ [R=301,L]
RewriteRule ^peinture-marquage-sol-parking-lyon/?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]
RewriteRule ^rebouchage-nids-poules-rhones-alpes/?$ https://renov-route.com/competences/reparation-nids-de-poule/ [R=301,L]
RewriteRule ^marquage/?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]
RewriteRule ^renov-route/?$ https://renov-route.com/competences/ [R=301,L]
RewriteRule ^home/?$ https://renov-route.com/ [R=301,L]
RewriteRule ^blank-2/?$ https://renov-route.com/competences/resine-sol-marquage-interieur/ [R=301,L]
RewriteRule ^nos-references/?$ https://renov-route.com/realisations/ [R=301,L]
RewriteRule ^devis-gratuit/?$ https://renov-route.com/devis/ [R=301,L]
RewriteRule ^devis-tracage-gratuit/?$ https://renov-route.com/devis/ [R=301,L]
RewriteRule ^services/renovation-parking/?$ https://renov-route.com/competences/ [R=301,L]
RewriteRule ^auvergne-rhone-alpes/?$ https://renov-route.com/competences/ [R=301,L]

# Deux URLs heritees encore explorees par Google (rapport « Exploree, actuellement
# non indexee ») tombaient en 404 : elles n'avaient pas d'equivalent dans le bloc
# ci-dessus. L'ancienne page d'avis correspond desormais a la section temoignages
# de l'accueil.
# NE est indispensable : sans lui mod_rewrite encode le « # » en %23 et l'ancre casse.
RewriteRule ^avis/?$ https://renov-route.com/#temoignages [R=301,NE,L]

# Arrondissements lyonnais consolides vers la page pilier Lyon.
# Ces pages existaient et se positionnaient sur les requetes commerciales locales
# (« entreprise de marquage au sol routier lyon »). Les redirections declarees dans
# vercel.json ne s'appliquent pas : le deploiement est FTP + Apache, pas Vercel.
RewriteRule ^marquage-au-sol-lyon-[1-9]/?$ https://renov-route.com/marquage-au-sol-lyon/ [R=301,L]

# Anciennes URLs realisations avec parametre ?project=
RewriteCond %{QUERY_STRING} (?:^|&)project=([a-z0-9-]+) [NC]
RewriteRule ^realisations/?$ https://renov-route.com/realisations/%1/? [R=301,L]

# Redirections géographiques vers les compétences correspondantes
# IMPORTANT: Exclure les sections actuelles (/guides/, /competences/, etc.)
# pour ne pas rediriger les nouvelles URLs vers les anciennes
RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteCond %{REQUEST_URI} !^/marquage-au-sol-lyon/
RewriteRule ^marquage-parking-([^/]+)/?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]

RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteRule ^tracage-parking-([^/]+)/?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]

RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteRule ^marquage-routier-([^/]+)/?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]

RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteRule ^reparation-nids-poule-([^/]+)/?$ https://renov-route.com/competences/reparation-nids-de-poule/ [R=301,L]

RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteRule ^signalisation-([^/]+)/?$ https://renov-route.com/competences/signalisation-verticale/ [R=301,L]

RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteRule ^accessoires-parking-([^/]+)/?$ https://renov-route.com/competences/accessoires-parking/ [R=301,L]

RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteRule ^resine-sol-([^/]+)/?$ https://renov-route.com/competences/resine-sol-marquage-interieur/ [R=301,L]

RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteRule ^conseil-expertise-([^/]+)/?$ https://renov-route.com/competences/conseil-expertise/ [R=301,L]

# Variantes geographiques « peinture-marquage-* » (ex. peinture-marquage-parking-42).
# Seule la declinaison lyonnaise etait couverte plus haut ; les autres tombaient en 404.
RewriteCond %{REQUEST_URI} !^/guides/
RewriteCond %{REQUEST_URI} !^/competences/
RewriteCond %{REQUEST_URI} !^/devis/
RewriteCond %{REQUEST_URI} !^/realisations/
RewriteCond %{REQUEST_URI} !^/qui-sommes-nous/
RewriteRule ^peinture-marquage-([^/]+)/?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]

# Redirections d'anciens formats d'URL
RewriteRule ^index\.html?$ https://renov-route.com/ [R=301,L]
RewriteRule ^home\.html?$ https://renov-route.com/ [R=301,L]
RewriteRule ^accueil\.html?$ https://renov-route.com/ [R=301,L]
RewriteRule ^services\.html?$ https://renov-route.com/competences/ [R=301,L]
RewriteRule ^prestations\.html?$ https://renov-route.com/competences/ [R=301,L]
RewriteRule ^nos-services\.html?$ https://renov-route.com/competences/ [R=301,L]
RewriteRule ^about\.html?$ https://renov-route.com/qui-sommes-nous/ [R=301,L]
RewriteRule ^a-propos\.html?$ https://renov-route.com/qui-sommes-nous/ [R=301,L]
RewriteRule ^equipe\.html?$ https://renov-route.com/qui-sommes-nous/ [R=301,L]
RewriteRule ^portfolio\.html?$ https://renov-route.com/realisations/ [R=301,L]
RewriteRule ^projets\.html?$ https://renov-route.com/realisations/ [R=301,L]
RewriteRule ^galerie\.html?$ https://renov-route.com/realisations/ [R=301,L]
RewriteRule ^travaux\.html?$ https://renov-route.com/realisations/ [R=301,L]
RewriteRule ^demande-devis\.html?$ https://renov-route.com/devis/ [R=301,L]
RewriteRule ^estimation\.html?$ https://renov-route.com/devis/ [R=301,L]

RewriteRule ^guides/couleur-marquage-sol-parking/?$ https://renov-route.com/guides/marquage-au-sol-signification-couleurs/ [R=301,L]

RewriteRule ^guides/panneau-pmr-parking-types-obligations/?$ https://renov-route.com/guides/signalisation-pmr-parking/ [R=301,L]

RewriteRule ^guides/reglementation-marquage-sol-parking/?$ https://renov-route.com/guides/signalisation-parking-reglementation/ [R=301,L]

RewriteRule ^guides/mise-en-conformite-parking-pmr/?$ https://renov-route.com/guides/normes-pmr-parking/ [R=301,L]

# Redirections heritees de l'ancien site. Elles n'existaient que dans le
# .htaccess a la racine du projet, qui n'est pas deploye : en production ces
# URL tombaient dans le fallback SPA et partaient vers l'accueil. /tarifs/ est
# la seule que la Search Console signale explicitement, mais les autres etaient
# dans le meme cas.
# La regle « ^marquage-([^/]+)/?$ » du fichier racine est volontairement omise :
# elle capturerait les 35 pages villes /marquage-au-sol-*, pilier Lyon compris.
RewriteRule ^tarifs/?$ https://renov-route.com/guides/prix-marquage-sol-parking/ [R=301,L]
RewriteRule ^contact\.html?$ https://renov-route.com/devis/ [R=301,L]
RewriteRule ^marquage-parking\.html?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]
RewriteRule ^tracage-parking\.html?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]
RewriteRule ^retracage-parking\.html?$ https://renov-route.com/competences/tracage-retracage-parking/ [R=301,L]
RewriteRule ^panneaux-signalisation\.html?$ https://renov-route.com/competences/signalisation-verticale/ [R=301,L]
RewriteRule ^signalisation\.html?$ https://renov-route.com/competences/signalisation-verticale/ [R=301,L]
RewriteRule ^panneaux\.html?$ https://renov-route.com/competences/signalisation-verticale/ [R=301,L]
RewriteRule ^resine-sol\.html?$ https://renov-route.com/competences/resine-sol-marquage-interieur/ [R=301,L]
RewriteRule ^marquage-interieur\.html?$ https://renov-route.com/competences/resine-sol-marquage-interieur/ [R=301,L]
RewriteRule ^revetement-sol\.html?$ https://renov-route.com/competences/resine-sol-marquage-interieur/ [R=301,L]
RewriteRule ^reparation-route\.html?$ https://renov-route.com/competences/reparation-nids-de-poule/ [R=301,L]
RewriteRule ^nids-poule\.html?$ https://renov-route.com/competences/reparation-nids-de-poule/ [R=301,L]
RewriteRule ^reparation-chaussee\.html?$ https://renov-route.com/competences/reparation-nids-de-poule/ [R=301,L]
RewriteRule ^equipements-parking\.html?$ https://renov-route.com/competences/accessoires-parking/ [R=301,L]
RewriteRule ^bornes-parking\.html?$ https://renov-route.com/competences/accessoires-parking/ [R=301,L]
RewriteRule ^accessoires\.html?$ https://renov-route.com/competences/accessoires-parking/ [R=301,L]
RewriteRule ^conseil\.html?$ https://renov-route.com/competences/conseil-expertise/ [R=301,L]
RewriteRule ^expertise\.html?$ https://renov-route.com/competences/conseil-expertise/ [R=301,L]
RewriteRule ^accompagnement\.html?$ https://renov-route.com/competences/conseil-expertise/ [R=301,L]
RewriteRule ^services/([^/]+)\.html?$ https://renov-route.com/competences/ [R=301,L]
RewriteRule ^competences/([^/]+)\.html?$ https://renov-route.com/competences/$1/ [R=301,L]
RewriteRule ^page/([^/]+)\.html?$ https://renov-route.com/$1/ [R=301,L]
RewriteRule ^category/([^/]+)\.html?$ https://renov-route.com/competences/$1/ [R=301,L]
RewriteRule ^old-site/(.*)$ https://renov-route.com/$1 [R=301,L]
RewriteRule ^ancien-site/(.*)$ https://renov-route.com/$1 [R=301,L]

# Vraie page 404.
#
# Il y avait ici un fallback SPA (`RewriteRule ^(.*)$ /index.html [L]`) herite d'une
# app client-side. Il est non seulement inutile sur un export statique — chaque route
# a deja son propre index.html sur disque — mais nuisible : le [L] relancait le cycle
# de reecriture avec /index.html, ce qui declenchait la regle `^index\.html?$ / [R=301]`
# plus haut. Resultat : *toute* URL inexistante etait redirigee en 301 vers l'accueil
# au lieu de renvoyer un 404. Google traite ce motif comme du soft-404 de masse.
ErrorDocument 404 /404.html

# Force UTF-8 encoding for text-based files
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .html .htm .css .js .xml .json .svg

# Security headers
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# Content Security Policy
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob: https://www.googletagmanager.com https://www.google-analytics.com https://maps.gstatic.com https://maps.googleapis.com; connect-src 'self' https: https://www.googletagmanager.com https://www.google-analytics.com https://analytics.google.com; frame-src 'self' https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://api.emailjs.com; frame-ancestors 'none'; upgrade-insecure-requests"

# Cache control
<FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

<FilesMatch "\.(js|css|png|jpg|jpeg|avif|webp|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>