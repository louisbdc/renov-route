{
  "redirects": [
    { "source": "/marquage-au-sol-lyon-1/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    { "source": "/marquage-au-sol-lyon-2/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    { "source": "/marquage-au-sol-lyon-3/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    { "source": "/marquage-au-sol-lyon-4/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    { "source": "/marquage-au-sol-lyon-5/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    { "source": "/marquage-au-sol-lyon-6/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    { "source": "/marquage-au-sol-lyon-7/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    { "source": "/marquage-au-sol-lyon-8/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    { "source": "/marquage-au-sol-lyon-9/", "destination": "/marquage-au-sol-lyon/", "permanent": true },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.renov-route.com"
        }
      ],
      "destination": "https://renov-route.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
